POSTGRES_DB=halfqr
POSTGRES_USER=halfqr
POSTGRES_PASSWORD=change-me-postgres
RABBITMQ_DEFAULT_USER=halfqr
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
NEXT_PUBLIC_HALFQR_API_BASE_URL=https://halfqr-api-demo.computemore.com
HALFQR_WEBAPP_PUBLIC_ORIGIN=https://halfqr.computemore.com
HALFQR_WEBAPP_LOCAL_ORIGIN=http://localhost:5173
RENDER_ARTIFACT_PROVIDER=FileSystem
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_KEY_PREFIX=render-jobs

# Required. Generate each with: openssl rand -base64 48
REDIS_PASSWORD=change-me-redis
HALFQR_INTERNAL_API_KEY=change-me-internal-key
HALFQR_PROXY_SECRET=change-me-proxy-secret

# true rejects anonymous PublicApi calls. The webapp builder needs false until it renders with a key.
HALFQR_REQUIRE_API_KEY=false

# Google OAuth (stubbed until a client is created). Redirect URI: <public origin>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Resend for email verification links
RESEND_API_KEY=
RESEND_FROM_ADDRESS=HalfQR <no-reply@halfqr.com>

# PayChangu for paid plans. Webhook URL must reach billing at /api/v1/billing/webhooks/paychangu
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_WEBHOOK_URL=
